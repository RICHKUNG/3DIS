# Full Pipeline Configuration (Aggregation + Inference)
# Complete workflow from My3DIS tracking outputs to OV-3DIS predictions
#
# Usage:
#   # Single scene mode (legacy)
#   python scripts/run_full_pipeline.py --config configs/inference/full_pipeline.yaml
#
#   # Multi-scene mode (NEW)
#   python scripts/run_full_pipeline.py --config configs/inference/full_pipeline.yaml --multi-scene
#
# This config integrates:
#   1. Aggregation: 2D masks → 3D proposals
#   2. Feature Extraction: SigLIP feature extraction
#   3. Inference: Open-vocabulary instance segmentation
#   4. (Optional) Evaluation: Search3D evaluation

# ============================================================================
# Experiment Settings
# ============================================================================
experiment:
  # ===== SINGLE SCENE MODE (Legacy) =====
  # Path to My3DIS experiment directory (SCENE-SPECIFIC)
  # This directory should contain:
  #   - level_2/video_segments_L02.npz
  #   - level_4/video_segments_L04.npz
  #   - level_6/video_segments_L06.npz
  #   - relations/family_tree.json
  # NOTE: For multi-scene experiments, this should point to the scene subdirectory,
  #       e.g., .../test_1108_ssam4_filter500_fill500_propinf/scene_00005_00
  # CHANGED: Testing scene_00093_01 (34.7% coverage, 11 labels) vs scene_00005_01 (15.4% coverage, 7 labels)
  # exp_dir: /media/Pluto/richkung/My3DIS/outputs/experiments/test_v7_246_ssam4_filter200_fill200_prop30_1116

  # Path to MultiScan scene directory (for 3D reconstruction)
  # Example: /media/public_dataset2/multiscan/scene_00005_00
  # scene_path: /media/public_dataset2/multiscan

  # ===== MULTI-SCENE MODE (NEW) =====
  # Enable multi-scene processing mode
  # When enabled, exp_root should point to an experiment root directory
  # containing multiple scene subdirectories (e.g., scene_00005_00, scene_00093_01)
  multi_scene_mode: True  # Set to true to enable multi-scene processing

  # Experiment root directory for multi-scene mode
  # This should contain multiple scene subdirectories
  # Example: /media/Pluto/richkung/My3DIS/outputs/experiments/v6_135_ssam2_filter10_fill50_propinf
  exp_root: /media/Pluto/richkung/My3DIS/outputs/experiments/test_v7_246_ssam4_filter200_fill200_prop30_1116

  # Dataset root for MultiScan scenes (for multi-scene mode)
  # Scene paths will be constructed as: {dataset_root}/{scene_name}
  dataset_root: /media/public_dataset2/multiscan

  # Scene selection for multi-scene mode
  # Options:
  #   - null or "all": Process all scenes found in exp_root
  #   - List of scene names: ["scene_00005_00", "scene_00093_01"]
  #   - Pattern matching: "scene_0009*" (glob pattern)
  scenes: all  # Process all scenes in exp_root

  # Levels to process (will be auto-detected from exp_dir if null)
  # Set explicitly if you want to override auto-detection
  # Example: [1, 3, 5] or [2, 4, 6]
  levels: null  # Auto-detect from level_* directories in exp_dir

  # Output directory for aggregation results (NPZ files, features, etc.)
  # Default: {exp_dir}/aggregation_output
  # If null, will use exp_dir/aggregation_output
  aggregation_output_dir: null

  # Output directory for inference results (predictions, visualizations, etc.)
  # Default: {exp_dir}/inference_output
  # If null, will use exp_dir/inference_output
  inference_output_dir: null

  # Levels to process (should match your experiment levels)
  # Device configuration
  # Options:
  #   - cuda (use default GPU)
  #   - cuda:0, cuda:1, etc. (specific GPU)
  #   - cpu (use CPU)
  device: cuda:0

# ============================================================================
# Aggregation Stage Configuration
# ============================================================================
aggregation:
  # Enable/disable aggregation stage
  enabled: true

  # IoU threshold for merging overlapping proposals
  iou_threshold: 0.5  # LOWERED from 0.8 to merge more overlapping masks → better coverage

  # Minimum area as fraction of total 3D points
  # Formula: min_points = num_points * area_fraction
  # Default 1/500 means proposals must have at least P/500 points
  area_fraction: 0.001  # LOWERED from 0.002 (1/1000) to preserve smaller regions → better coverage

  # Per-level area fractions (optional)
  # If specified, overrides area_fraction for specific levels
  # Useful for applying different size thresholds to different granularity levels
  # Example: Stricter filtering for coarse levels, more permissive for fine levels
  area_fraction_per_level: null  # Example: {2: 0.003, 4: 0.002, 6: 0.001}

  # Feature extraction settings
  extract_features: true

  # SigLIP model for feature extraction
  # Options:
  #   - google/siglip-so400m-patch14-384 (default)
  #   - google/siglip-large-patch16-384
  #   - Path to local model directory
  siglip_model: google/siglip-so400m-patch14-384

  # Feature pooling mode
  # Options:
  #   - average: Average point features, then L2 normalize
  #   - voting: Average point features, NO L2 normalization (preserves magnitude)
  pooling_mode: average  # CHANGED from voting to average for better feature similarity

  # Configuration for 3D projection (from pipeline.ipynb)
  projection:
    vis_depth_threshold: 0.1  # Depth threshold for visibility computation
    frequency: 50              # Frame sampling frequency
    resize_ratio: 0.3          # Mask downscale ratio (must match tracker settings)
    depth_scale: 1000.0        # Depth unit conversion

# ============================================================================
# Inference Stage Configuration
# ============================================================================
inference:
  # Enable/disable inference stage
  enabled: true

  # Export predictions as PLY point clouds (for visualization/debugging)
  export_predictions_ply: true
  ply_export_max_predictions: 50
  ply_export_include_full_scene: true
  ply_export_background_color: [80, 80, 80]
  ply_export_colors:
    - [255, 99, 71]
    - [102, 205, 170]
    - [65, 105, 225]
    - [218, 112, 214]
    - [255, 215, 0]
    - [0, 191, 255]
    - [144, 238, 144]
    - [255, 140, 0]

  # Multi-Strategy Testing (NEW)
  # When enabled, runs inference with all specified strategies and generates comparison report
  test_all_strategies: true  # Default: true (test all strategies)

  # Strategies to test when test_all_strategies=true
  # Available: independent, hierarchical, exhaustive_pairing
  strategies_to_test: [independent, hierarchical, exhaustive_pairing]

  # Single Strategy Selection (used when test_all_strategies=false)
  # Strategy: independent, hierarchical, or exhaustive_pairing
  # - independent: Retrieve objects and parts independently, then pair
  # - hierarchical: Coarse-to-fine retrieval using hierarchy
  # - exhaustive_pairing: Exhaustive level-pair evaluation with smart selection
  strategy: independent

  # Multi-level retrieval configuration
  retrieval:
    temperature: 0.2              # Temperature for similarity scoring (lower = sharper)
    min_similarity: 0.005         # LOWERED from 0.01 to capture more candidates
    top_k_per_level: 500          # INCREASED from 200 to get more candidates
    object_levels: auto           # Auto-detect from aggregation output (coarser levels)
    part_levels: auto             # Auto-detect from aggregation output (finer levels)

  # Object-Part pairing configuration
  pairing:
    containment_threshold: 0.001  # Min containment ratio (part in object) - EXTREMELY RELAXED (0.1% overlap)
    scale_range: [0.0001, 20.0]   # Valid size ratio range (part/object) - Allow part up to 20x object
    use_geometric_score: false    # Include geometric score in final score - DISABLED for combined query
    use_tree_pruning: false       # Use family tree to prune infeasible pairs - DISABLED for debugging

  # Non-Maximum Suppression configuration (multi-instance aware)
  nms:
    iou_threshold: 0.25           # LOWERED from 0.35 to preserve more predictions
    use_soft_nms: false           # Use soft NMS (score decay) instead of hard removal
    soft_nms_sigma: 0.5           # Sigma for soft NMS Gaussian decay
    centroid_distance_ratio: 0.2  # Spatial separation threshold (as ratio of mask size)
    keep_top_k: 300               # INCREASED from 200 to keep more predictions

  # Score aggregation configuration
  scoring:
    method: arithmetic            # Options: arithmetic, geometric, weighted_sum, max, min
                                   # arithmetic: (object_score + part_score) / 2 (recommended for combined query)
    weights:
      object: 0.5                 # Weight for object similarity (used in weighted_sum)
      part: 0.5                   # Weight for part similarity (used in weighted_sum)
      geometric: 0.0              # Weight for geometric compatibility (disabled for combined query)
    temperature: 1.0              # Temperature for score scaling
    hierarchy_bonus: 0.05         # Bonus for expected level relationships

  # Output formatting configuration
  formatter:
    use_part_mask: true           # Use part mask (vs object mask or union)
    min_mask_size: 10             # Minimum mask size in points

  # Independent strategy specific parameters
  independent:
    object_levels: auto           # Auto-detect from aggregation output (coarser levels)
    part_levels: auto             # Auto-detect from aggregation output (finer levels)
    top_k_per_level: 200          # INCREASED from 100
    retrieval_threshold: 0.05     # LOWERED from 0.2 (much more permissive)
    min_retrieval_threshold: 0.005 # LOWERED from 0.01 (very permissive)
    threshold_backoff_step: 0.01  # REDUCED from 0.03 for finer steps
    fallback_to_topk: true

    # Combined Query Settings (DEFAULT)
    use_combined_query: true      # Use "part of object" combined queries (DEFAULT)
    siglip_model: google/siglip-so400m-patch14-384
    siglip_device: cuda:0

  # Hierarchical strategy specific parameters
  hierarchical:
    coarse_top_k: 200             # INCREASED from 150
    object_top_k: 200             # INCREASED from 100
    part_top_k: 100               # INCREASED from 50
    coarse_threshold: 0.01        # LOWERED from 0.05 (very permissive)
    refinement_threshold: 0.01    # LOWERED from 0.1 (very permissive)
    refinement_margin: 0.01       # LOWERED from 0.05

    # Combined Query Settings (DEFAULT)
    use_combined_query: true      # Use "part of object" combined queries (DEFAULT)
    siglip_model: google/siglip-so400m-patch14-384
    siglip_device: cuda:0

  # Exhaustive pairing strategy specific parameters
  exhaustive_pairing:
    available_levels: auto          # Auto-detect all available levels from aggregation output
    top_k_per_level: 200            # INCREASED from 100
    retrieval_threshold: 0.05       # LOWERED from 0.2 (much more permissive)
    min_retrieval_threshold: 0.005  # LOWERED from 0.05 (very permissive)
    threshold_backoff_step: 0.01    # REDUCED from 0.03 for finer steps
    fallback_to_topk: true          # Fall back to top-k if no proposals above threshold
    selection_metric: max           # How to select best level-pair: 'max', 'mean', or 'sum'
    use_tree_pruning: false         # Use family tree to prune infeasible pairs
    return_all_pairs: false         # Return pairs from all levels (true) or only best (false)

    # Combined Query Settings (DEFAULT BEHAVIOR)
    # Uses "part of object" combined queries with SigLIP feature extraction
    # This is the recommended approach for OV part-level inference
    use_combined_query: true        # Enable combined "X of Y" query mode (DEFAULT)
    siglip_model: google/siglip-so400m-patch14-384  # SigLIP model for combined query features
    siglip_device: cuda:0           # Device for SigLIP model (cuda:0, cuda:1, or cpu)

# ============================================================================
# Evaluation Stage Configuration (Optional)
# ============================================================================
evaluation:
  # Enable/disable evaluation stage
  enabled: true

  # Ground truth path for OV object-part evaluation
  gt_paths:
    obj_part: /media/Pluto/richkung/My3DIS/data/search3d_gt/multiscan_data_search3d/multiscan_annotations_search3d/ov_part_annotations

  # Ground truth PLY files directory (for Search3D format export)
  # These are the standardized test scene PLY files used for evaluation
  gt_ply_path: /media/Pluto/richkung/My3DIS/data/search3d_gt/multiscan_data_search3d/multiscan_test_plys_only

  # Evaluation modes to run (obj_part only)
  eval_modes: ['obj_part']

  # Evaluation script for obj_part
  eval_scripts:
    obj_part: eval/search3d/eval_semantic_instance_parts_OV.py

  # DEPRECATED: Use gt_paths.obj_part instead
  # Kept for backward compatibility
  gt_path: null

  # Path to Search3D query file
  # If null, will use all queries from eval/search3d_ov_part_queries.txt
  query_file: /media/Pluto/richkung/My3DIS/eval/search3d/eval_semantic_instance_parts_OV.py

  # Dataset root for MultiScan
  dataset_root: /media/public_dataset2/multiscan

  # Scene filtering (null = all scenes in experiment)
  scenes: null

  # Number of workers for parallel evaluation
  num_workers: 4

  # Output evaluation results
  save_per_scene_metrics: true
  save_per_class_metrics: true

# ============================================================================
# Logging and Debugging
# ============================================================================
logging:
  level: INFO  # DEBUG, INFO, WARNING, ERROR
  save_logs: true
  log_file: pipeline.log
